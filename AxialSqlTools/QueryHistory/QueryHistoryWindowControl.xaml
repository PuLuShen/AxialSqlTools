<UserControl x:Class="AxialSqlTools.QueryHistoryWindowControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit" Background="{DynamicResource AxialThemeBackgroundBrush}" Foreground="{DynamicResource AxialThemeForegroundBrush}">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/AxialSqlTools;component/Themes/SharedToolWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="2*"/></Grid.RowDefinitions>

  <DockPanel Grid.Row="0" Margin="0,0,0,6">
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
    <TextBlock Text="{Binding LastRefreshed}" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.75"/>
    <Button Content="Refresh" Width="80" Command="{Binding RefreshCommand}" Style="{DynamicResource AxialPrimaryButtonStyle}"/>
   </StackPanel>
   <TextBlock Text="Query History" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
  </DockPanel>

  <Border Grid.Row="1" Padding="8" Margin="0,0,0,6" BorderThickness="1" CornerRadius="2" BorderBrush="{DynamicResource AxialThemeBorderBrush}" Background="{DynamicResource AxialThemeHeaderBackgroundBrush}">
   <DockPanel>
    <ProgressBar DockPanel.Dock="Right" Width="90" Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Style.Triggers><DataTrigger Binding="{Binding StatusKind}" Value="Error"><Setter Property="Foreground" Value="#E5534B"/></DataTrigger><DataTrigger Binding="{Binding StatusKind}" Value="Warning"><Setter Property="Foreground" Value="#D99A22"/></DataTrigger><DataTrigger Binding="{Binding StatusKind}" Value="Success"><Setter Property="Foreground" Value="#3AA675"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </DockPanel>
  </Border>

  <Border Grid.Row="2" Padding="6" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{DynamicResource AxialThemeBorderBrush}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
     <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,5,0"/><Button Content="Today" Tag="1" Click="DatePreset_Click" Margin="0,0,4,0"/><Button Content="7 days" Tag="7" Click="DatePreset_Click" Margin="0,0,4,0"/><Button Content="30 days" Tag="30" Click="DatePreset_Click" Margin="0,0,10,0"/><Button Content="Current connection" Click="CurrentConnection_Click" Margin="0,0,10,0"/>
     <DatePicker Width="125" SelectedDate="{Binding FilterFromDate, Mode=TwoWay}"/><TextBlock Text="–" Margin="5,0" VerticalAlignment="Center"/><DatePicker Width="125" SelectedDate="{Binding FilterToDate, Mode=TwoWay}"/>
     <TextBlock Text="Result:" Margin="14,0,5,0" VerticalAlignment="Center"/><ComboBox Width="110" ItemsSource="{Binding ResultOptions}" SelectedItem="{Binding FilterResult}"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" Margin="0,0,5,0"><TextBlock Text="Server"/><TextBox Text="{Binding FilterServer, UpdateSourceTrigger=PropertyChanged}" ToolTip="Server contains..." KeyDown="Filter_KeyDown"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,5,0"><TextBlock Text="Database"/><TextBox Text="{Binding FilterDatabase, UpdateSourceTrigger=PropertyChanged}" ToolTip="Database contains..." KeyDown="Filter_KeyDown"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="0,0,5,0"><TextBlock Text="Login"/><TextBox Text="{Binding FilterLogin, UpdateSourceTrigger=PropertyChanged}" ToolTip="Login contains..." KeyDown="Filter_KeyDown"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="SQL keywords"/><TextBox Text="{Binding FilterQueryText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Separate keywords with spaces; all terms must match" KeyDown="Filter_KeyDown"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Apply filters" Width="95" Command="{Binding RefreshCommand}" Style="{DynamicResource AxialPrimaryButtonStyle}"/><Button Content="Clear filters" Width="95" Margin="5,0,0,0" Command="{Binding ClearFilterCommand}"/></StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="2,0,2,4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Previous" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageSummary}" Margin="9,0" VerticalAlignment="Center"/><Button Content="Next" Command="{Binding NextPageCommand}"/></StackPanel><TextBlock Text="{Binding ResultSummary}" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
   <DataGrid x:Name="HistoryGrid" Grid.Row="1" IsReadOnly="True" ItemsSource="{Binding QueryHistoryRecords}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="HistoryGrid_SelectionChanged" MouseDoubleClick="HistoryGrid_MouseDoubleClick" Style="{DynamicResource AxialThemedDataGridStyle}" ColumnHeaderStyle="{DynamicResource AxialThemedDataGridColumnHeaderStyle}" CellStyle="{DynamicResource AxialThemedDataGridCellStyle}" RowStyle="{DynamicResource AxialThemedDataGridRowStyle}">
    <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Open in new query window" Click="OpenQuery_Click"/><MenuItem Header="Copy SQL" Click="CopyQuery_Click"/></ContextMenu></DataGrid.ContextMenu>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Started" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145"/>
     <DataGridTextColumn Header="Query" Binding="{Binding QueryTextShort}" Width="*" MinWidth="250"/>
     <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="130"/>
     <DataGridTextColumn Header="Elapsed" Binding="{Binding ElapsedTime}" Width="80"/>
     <DataGridTextColumn Header="Result" Binding="{Binding ExecResult}" Width="90"/>
     <DataGridTextColumn Header="Server" Binding="{Binding DataSource}" Width="130"/>
     <DataGridTextColumn Header="Rows" Binding="{Binding TotalRowsReturned, StringFormat=N0}" Width="70"/>
     <DataGridTextColumn Header="Login" Binding="{Binding LoginName}" Width="100" Visibility="Collapsed"/>
     <DataGridTextColumn Header="Workstation" Binding="{Binding WorkstationId}" Width="100" Visibility="Collapsed"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
  <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
  <Grid Grid.Row="5"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,2,0,4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><CheckBox x:Name="WrapSql" Content="Wrap lines" Margin="0,0,10,0" VerticalAlignment="Center" Checked="WrapSql_Changed" Unchecked="WrapSql_Changed"/><Button Content="Copy SQL" Click="CopyQuery_Click"/><Button Content="Open in new query window" Margin="5,0,0,0" Click="OpenQuery_Click" Style="{DynamicResource AxialPrimaryButtonStyle}"/></StackPanel><TextBlock Text="SQL details" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
   <avalonedit:TextEditor x:Name="SqlEditor" Grid.Row="1" FontFamily="Consolas" FontSize="12" IsReadOnly="True" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
  </Grid>
 </Grid>
</UserControl>
